    "⚠️ This will delete duplicate CloudKit records and rebuild your local tracking. Only use this if you're seeing incorrect recipe counts." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Ceci supprimera les enregistrements CloudKit en double et reconstruira votre suivi local. À n'utiliser que si le nombre de recettes affiché est incorrect."
          }
        }
      }
    },
    "⚠️ This will try to migrate any file-based images to the database. Make sure you have a backup!" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Ceci tentera de migrer vers la base de données les images stockées en fichiers. Assurez-vous d'avoir une sauvegarde !"
