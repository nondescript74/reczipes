            "value" : "Recettes sur cet appareil"
          }
        }
      }
    },
    "Recipes that belong to a book are never deleted anywhere else in the app. Use this only when you are sure. You will have to type the recipe's title to confirm." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recettes qui appartiennent à un livre ne sont jamais supprimées ailleurs dans l'app. N'utilisez ceci que si vous êtes sûr. Vous devrez taper le titre de la recette pour confirmer."
          }
        }
      }
    },
