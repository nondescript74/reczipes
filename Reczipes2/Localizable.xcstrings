          }
        }
      }
    },
    "These recipe books exist in CloudKit but aren't tracked locally. They may be from a previous device or installation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces livres de recettes existent dans CloudKit mais ne sont pas suivis localement. Ils viennent peut-être d'un ancien appareil ou d'une ancienne installation."
          }
        }
      }
    },
    "These recipes are stored more than once under the same ID. One copy of each is kept; extras are removed only when their content is identical. Books and website copies are unaffected (they refer to the ID, which stays)." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces recettes sont stockées plusieurs fois sous le même identifiant. Une copie de chacune est gardée ; les doublons ne sont retirés que si leur contenu est identique. Les livres et les copies web ne sont pas affectés (ils renvoient à l'identifiant, qui reste)."
          }
