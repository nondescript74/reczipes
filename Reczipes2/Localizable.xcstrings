            "value" : "Vous n'avez encore partagé aucune recette ni aucun livre."
          }
        }
      }
    },
    "You must accept the license agreement to use Reczipes. If you decline, the app will close." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devez accepter le contrat de licence pour utiliser Reczipes. Si vous refusez, l'app se fermera."
          }
        }
      }
    },
    "You'll be able to crop each image individually" : {
