        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez recadrer chaque image séparément"
          }
        }
      }
    },
    "You're offline" : {
      "comment" : "Error title: no internet connection",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne"
          }
        }
      }
    },
    "You're ready to share your recipes with the community and browse recipes shared by others." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes prêt à partager vos recettes avec la communauté et à parcourir celles partagées par d'autres."
          }
        }
      }
    },
    "You've granted limited photo access. To see more photos, go to Settings and change photo access to 'Full Access'." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez accordé un accès limité aux photos. Pour voir plus de photos, allez dans Réglages et choisissez « Accès complet »."
          }
        }
      }
    },
    "Your API key will be tested before saving." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé API sera testée avant d'être enregistrée."
          }
        }
      }
    },
    "Your Anthropic account doesn't allow this key to do that. Check the key's workspace in your Anthropic account, or paste a different key." : {
      "comment" : "Error message: key lacks permission",
      "localizations" : {
        "fr" : {
