    },
    "FODMAP analysis is based on research from Monash University, the creators of the Low FODMAP Diet. For the most accurate and up-to-date information, consult a registered dietitian and visit the official Monash FODMAP app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'analyse FODMAP s'appuie sur les recherches de l'Université Monash, créatrice du régime pauvre en FODMAP. Pour des informations exactes et à jour, consultez un diététicien et l'app officielle Monash FODMAP."
          }
        }
      }
    },
    "FODMAP stands for Fermentable Oligosaccharides, Disaccharides, Monosaccharides And Polyols" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FODMAP signifie oligosaccharides, disaccharides, monosaccharides et polyols fermentescibles"
          }
        }
      }
    },
    "FODMAP substitute available" : {
      "localizations" : {
