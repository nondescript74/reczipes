            "state" : "translated",
            "value" : "Cette recette n'est pas recommandée pour votre profil alimentaire. Choisissez une autre recette."
          }
        }
      }
    },
    "This recipe is part of: %@%@. Replacing it would affect these recipe books." : {
      "localizations" : {
