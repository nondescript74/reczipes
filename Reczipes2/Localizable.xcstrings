        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveautés (depuis getWhatsNew())"
          }
        }
      }
    },
    "Wheat grain and wheat-based products" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blé et produits à base de blé"
          }
        }
      }
    },
    "When auto-share is enabled, new recipes/books will be automatically shared with the community under Creative Commons BY 4.0 license (attribution required). Turn off to share items manually or keep them private. You retain full ownership and can stop sharing at any time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand le partage automatique est activé, les nouvelles recettes et nouveaux livres sont partagés automatiquement avec la communauté sous licence Creative Commons BY 4.0 (attribution requise). Désactivez-le pour partager à la main ou garder vos éléments privés. Vous restez propriétaire et pouvez arrêter de partager à tout moment."
          }
        }
      }
    },
    "When enabled, recipes will show FODMAP ingredient analysis and low FODMAP substitution suggestions based on Monash University guidelines." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand c'est activé, les recettes affichent une analyse des ingrédients FODMAP et des suggestions de substitution pauvres en FODMAP, selon les recommandations de l'Université Monash."
          }
        }
      }
    },
    "When enabled, recipes will show glycemic load estimates, carbohydrate counts, and diabetic-friendly substitution suggestions based on evidence-based dietary guidelines from reputable medical sources including the American Diabetes Association (ADA), Mayo Clinic, CDC, and NIH." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand c'est activé, les recettes affichent une estimation de la charge glycémique, le nombre de glucides et des suggestions de substitution adaptées au diabète, d'après des recommandations alimentaires fondées sur des données probantes provenant de sources médicales reconnues, dont l'American Diabetes Association (ADA), la Mayo Clinic, les CDC et les NIH."
          }
        }
      }
    },
    "When you request analysis for a recipe:" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous demandez l'analyse d'une recette :"
          }
        }
      }
    },
    "Where did you find this recipe?" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Où avez-vous trouvé cette recette ?"
