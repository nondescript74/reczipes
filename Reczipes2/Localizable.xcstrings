    "You already have a book with this name. Add the recipes to it instead." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà un livre portant ce nom. Ajoutez-y plutôt les recettes."
          }
        }
      }
    },
    "You can add your API key later in Settings. Without an API key, you won't be able to extract recipes from images." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez ajouter votre clé API plus tard dans Réglages. Sans clé API, vous ne pourrez pas extraire de recettes à partir d'images."
          }
        }
      }
    },
    "You can also set up your API key in Settings" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi configurer votre clé API dans Réglages"
          }
        }
      }
    },
    "You can crop each image individually before extraction, or skip cropping to process images faster." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez recadrer chaque image avant l'extraction, ou ne pas recadrer pour traiter les images plus vite."
          }
        }
      }
    },
    "You don't have any recipes yet" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez pas encore de recettes"
          }
        }
      }
    },
    "You have a diabetic analysis in progress for this recipe. Would you like to resume?" : {
      "localizations" : {
