    },
    "'%@' is in %@. Remove it from %@ first. Recipes that belong to a book are never deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' is in %2$@. Remove it from %3$@ first. Recipes that belong to a book are never deleted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est dans %2$@. Retirez-la d'abord de %3$@. Les recettes qui appartiennent à un livre ne sont jamais supprimées."
          }
        }
      }
    },
    "'%@' is protected because the list of books could not be read. Try again later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est protégée car la liste des livres n'a pas pu être lue. Réessayez plus tard."
