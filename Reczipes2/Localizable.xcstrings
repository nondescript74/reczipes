        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Génère un fichier JSON contenant les %1$lld repas%2$@ de votre bibliothèque, avec le lien vers la recette de chaque plat. Le fichier peut être réimporté ici pour restaurer vos repas."
